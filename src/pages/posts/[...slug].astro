---
// src/pages/posts/[...slug].astro
import { getCollection, render } from "astro:content";
import Post from "../../layouts/Post.astro";

export async function getStaticPaths() {
    const all = (await getCollection("posts"))
        .filter((p) => !p.data.draft || import.meta.env.DEV)
        .sort(
        (a, b) =>
            b.data.date.getTime() - a.data.date.getTime() ||
            a.id.localeCompare(b.id),
    );

    const published = all.filter((p) => !p.data.draft);

    return all.map((post) => {
        const i = published.indexOf(post);
        return {
            params: { slug: post.id },
            props: {
                post,
                newer: i === -1 ? null : (published[i - 1] ?? null),
                older: i === -1 ? null : (published[i + 1] ?? null),
            },
        };
    });
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<Post
    title={post.data.title}
    date={post.data.date}
    description={post.data.description}
>
    <Content />

    <nav class="not-prose mt-12 flex flex-col items-start sm:flex-row justify-between gap-6 font-display text-sm">
        {older && (
            <a href={`/posts/${older.id}`} class="text-left">
                <span class="block text-muted">← Previous</span>
                {older.data.title}
            </a>
        )}
        {newer && (
            <a href={`/posts/${newer.id}`} class="sm:ml-auto sm:text-right">
                <span class="block text-muted">Next →</span>
                {newer.data.title}
            </a>
        )}
    </nav>
</Post>
