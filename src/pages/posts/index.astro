---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import shrug from "../../assets/shrug.png";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("posts"))
    .filter((p) => !p.data.draft)
    .sort(
        (a, b) =>
            b.data.date.getTime() - a.data.date.getTime() ||
            a.id.localeCompare(b.id),
    );
---

<Base
    title="Ramblings | Its Fate!"
    description="Nonsense, opinions, occasional bad takes, fresh from my braincase."
>
    <section class="flex-1 flex flex-col w-full max-w-[65ch] mx-auto pb-6">
        <h1 class="text-3xl md:text-4xl font-semibold tracking-tight text-foreground">
            Ramblings
        </h1>
        <p class="mt-3 text-lg leading-snug text-muted">
            Nonsense, opinions, occasional bad takes, fresh from my braincase.
        </p>
        <ul class="mt-8 divide-y divide-border">
            {posts.map((p) => (
                <li class="relative py-4">
                    <a
                        href={`/posts/${p.id}`}
                        class="relative z-10 font-medium"
                    >
                        {p.data.title}
                    </a>
                    <a
                        href={`/posts/${p.id}`}
                        class="absolute inset-0"
                        aria-label={p.data.title}
                        aria-hidden="true"
                        tabindex="-1"
                    />
                    {p.data.description && (
                        <p class="mt-1 text-sm text-muted">
                            {p.data.description}
                        </p>
                    )}
                    <time
                        datetime={p.data.date.toISOString()}
                        class="block mt-1 text-sm text-muted"
                    >
                        {`${p.data.date.toLocaleDateString("en-GB", { month: "short", timeZone: "UTC" })} ${p.data.date.getUTCDate()}, ${p.data.date.getUTCFullYear()}`}
                    </time>
                </li>
            ))}
        </ul>
        <div class="mt-auto pt-16 flex flex-col items-center gap-4 text-center text-sm text-muted">
            <Image
                src={shrug}
                alt="Shrug"
                title="End of list. The author must be a lazy one."
                class="size-56 select-none"
                draggable="false"
                loading="eager"
                aria-hidden="true"
            />
            <p>Wow! You've reached the end of the list.</p>
        </div>
    </section>
</Base>

<style>
    /* Hover anywhere on the row highlights the title link */
    li:hover :global(.link-highlight-overlay) {
        clip-path: inset(0 0 0 0);
    }
</style>
